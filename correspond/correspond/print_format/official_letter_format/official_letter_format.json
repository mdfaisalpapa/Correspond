 "css": "/* Target the custom wrapper and force strict justification */\r\n.justified-letter-content,\r\n.justified-letter-content p,\r\n.justified-letter-content li,\r\n.justified-letter-content span {\r\n    text-align: justify !important;\r\n    text-justify: inter-word !important;\r\n}\r\n\r\n/* Fix for Quill editor block containers rendering in PDF */\r\n.justified-letter-content .ql-editor p,\r\n.justified-letter-content .ql-editor li {\r\n    text-align: justify !important;\r\n    display: block !important;\r\n    width: 100% !important;\r\n}\r\n\r\n/* Keep headings left-aligned so section headers don't stretch awkwardly */\r\n.justified-letter-content h1,\r\n.justified-letter-content h2,\r\n.justified-letter-content h3,\r\n.justified-letter-content h4 {\r\n    text-align: left !important;\r\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
