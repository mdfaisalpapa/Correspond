 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n    /* 1. ALLOW NATURAL PAGE BREAKS & FIX OVERFLOW */\r\n    .kvc3-letter div, \r\n    .kvc3-letter p,\r\n    .letter-body-content,\r\n    .letter-body-content .ql-snow,\r\n    .letter-body-content .ql-editor,\r\n    .letter-body-content .ql-editor div,\r\n    .letter-body-content .ql-editor p {\r\n        page-break-inside: auto !important;\r\n        page-break-before: auto !important;\r\n        page-break-after: auto !important;\r\n        overflow: visible !important; \r\n        display: block !important;\r\n        float: none !important;\r\n    }\r\n    \r\n    /* 2. KEEP TABLES AND SIGNATURES INTACT */\r\n    .kvc3-letter tr,\r\n    .kvc3-letter td,\r\n    .kvc3-letter li,\r\n    .keep-together {\r\n        page-break-inside: avoid !important;\r\n    }\r\n    \r\n    /* 3. TIGHTEN SPACING & FORCE JUSTIFY ON QUILL */\r\n    .letter-body-content {\r\n        font-size: 11pt !important;\r\n        line-height: 20px !important; \r\n    }\r\n\r\n    .letter-body-content .ql-editor p {\r\n        margin-top: 0px !important;\r\n        margin-bottom: 8px !important; \r\n        line-height: 20px !important;\r\n        text-align: justify !important;\r\n        text-justify: inter-word !important;\r\n        width: 100% !important; /* wkhtmltopdf needs strict width to justify */\r\n    }\r\n\r\n    /* 4. THE FIX FOR COPY-PASTED TEXT (STRIP SPAN RESTRICTIONS) */\r\n    .letter-body-content .ql-editor span {\r\n        display: inline !important;\r\n        white-space: normal !important;\r\n        letter-spacing: normal !important;\r\n        word-spacing: normal !important;\r\n        background-color: transparent !important;\r\n    }\r\n\r\n    /* 5. QUILL ALIGNMENT OVERRIDES (If manually aligned by user) */\r\n    .kvc3-letter .letter-body-content .ql-editor p.ql-align-center { text-align: center !important; }\r\n    .kvc3-letter .letter-body-content .ql-editor p.ql-align-right { text-align: right !important; }\r\n    .kvc3-letter .letter-body-content .ql-editor p.ql-align-left { text-align: left !important; }\r\n\r\n    /* 6. CLEANUP EMPTY TAGS */\r\n    .letter-body-content p:empty {\r\n        display: none !important;\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n    }\r\n</style>\r\n<div class=\"kvc3-letter\" style=\"font-family: Arial, sans-serif; font-size: 11pt; line-height: 1.6; max-width: 800px; margin: auto;\">\r\n    \r\n    <!-- KVC3 CUSTOM LETTER HEAD -->\r\n    <table style=\"width: 100%; border-bottom: 2px solid #2c3e50; padding-bottom: 15px; margin-bottom: 25px;\">\r\n        <tr>\r\n            <td style=\"width: 15%; vertical-align: middle; text-align: left;\">\r\n                <img src=\"/files/kvc3_logo.png\" style=\"max-width: 110px; height: auto;\" alt=\"KVC3 Logo\">\r\n            </td>\r\n            <td style=\"width: 85%; vertical-align: middle; text-align: center; line-height: 1.4;\">\r\n                <h2 style=\"margin: 0; color: #2c3e50; font-size: 18pt; font-weight: bold;\">KENDRIYA VIHAR PHASE-III</h2>\r\n                <h3 style=\"margin: 3px 0; color: #2c3e50; font-size: 14pt; font-weight: bold;\">ADHOC APARTMENT OWNERS ASSOCIATION (AoA)</h3>\r\n                <p style=\"margin: 0; font-size: 10.5pt; color: #333;\">Paruthipattu, Avadi, Chennai - 600071</p>\r\n                <p style=\"margin: 0; font-size: 10.5pt; color: #333;\"><strong>Email:</strong> kvc3aoa@gmail.com</p>\r\n                \r\n                <div style=\"margin-top: 8px; font-size: 9pt; color: #444; border-top: 1px solid #ddd; padding-top: 5px;\">\r\n                    <strong>President:</strong> R.P Rajalingam &nbsp;|&nbsp; \r\n                    <strong>Vice President:</strong> Smt R.P. Chitra Devi &nbsp;|&nbsp; \r\n                    <strong>Secretary:</strong> A. Mathivanan<br>\r\n                    <strong>Treasurer:</strong> R. Nagarajan &nbsp;|&nbsp; \r\n                    <strong>Joint Secretary:</strong> V. Rajaram\r\n                </div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    \r\n    <!-- HEADER: File Number and Date -->\r\n    <table style=\"width: 100%; border: none; margin-bottom: 30px;\">\r\n        <tr>\r\n            <td style=\"text-align: left; vertical-align: top;\">\r\n                <strong>No:</strong> {{ doc.name }}<br>\r\n                {% if doc.primary_file %}\r\n                    <strong>File Ref:</strong> {{ doc.primary_file }}\r\n                {% endif %}\r\n            </td>\r\n            <td style=\"text-align: right; vertical-align: top;\">\r\n                <strong>Date:</strong> {{ frappe.utils.formatdate(doc.creation) }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- TO ADDRESS -->\r\n    <div style=\"margin-bottom: 25px;\">\r\n        <strong>To,</strong><br>\r\n        {% if doc.recipient_type == 'Internal User' %}\r\n            {% set desk_title = frappe.db.get_value(\"Correspond Desk Profile\", doc.internal_recipient, \"desk_title\") or doc.internal_recipient %}\r\n            {{ desk_title }}\r\n        {% else %}\r\n            {{ doc.receiver | replace('\\n', '<br>') }}<br>\r\n            {% if doc.receiver_email %}\r\n                {{ doc.receiver_email }}\r\n            {% endif %}\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- SUBJECT & REFERENCE -->\r\n    <div class=\"keep-together\" style=\"margin-bottom: 25px; margin-left: 8%;\">\r\n        <table style=\"border: none; width: 100%;\">\r\n            <tr>\r\n                <td style=\"width: 50px; vertical-align: top;\"><strong>Sub:</strong></td>\r\n                <td style=\"white-space: pre-wrap;\">{{ doc.subject or '' }}</td>\r\n            </tr>\r\n            {% if doc.reference %}\r\n            <tr>\r\n                <td style=\"vertical-align: top; padding-top: 5px;\"><strong>Ref:</strong></td>\r\n                <td style=\"padding-top: 5px; white-space: pre-wrap;\">{{ doc.reference }}</td>\r\n            </tr>\r\n            {% endif %}\r\n        </table>\r\n    </div>\r\n\r\n    <!-- LETTER BODY -->\r\n    <div class=\"letter-body-content\" style=\"margin-bottom: 30px;\">\r\n        {{ doc.letter_body or '' }}\r\n    </div>\r\n\r\n   <!-- SIGNATURE BLOCK START -->\r\n<div style=\"width: 100%; text-align: right; padding-right: 30px; margin-top: 40px; page-break-inside: avoid;\">\r\n    \r\n    <div style=\"margin-bottom: 10px;\">Yours faithfully,</div>\r\n\r\n    {% if doc.sender %}\r\n        {% set desk = frappe.get_doc(\"Correspond Desk Profile\", doc.sender) %}\r\n        \r\n        {# Display the signature image #}\r\n        {% if desk.signature_block %}\r\n            <div class=\"clean-signature-container\">\r\n                {{ desk.signature_block }}\r\n            </div>\r\n        {% else %}\r\n            <div style=\"height: 65px;\"></div> \r\n        {% endif %}\r\n    {% endif %}\r\n\r\n</div>\r\n\r\n<!-- CSS to force the Text Editor content to align right and remove unwanted spacing -->\r\n<style>\r\n    .clean-signature-container * {\r\n        text-align: right !important;\r\n        margin: 0 !important;\r\n        padding: 0 !important;\r\n    }\r\n    .clean-signature-container img {\r\n        display: inline-block !important;\r\n    }\r\n</style>\r\n<!-- SIGNATURE BLOCK END -->\r\n    <!-- CC LIST -->\r\n    {% if doc.cc_list %}\r\n<div class=\"print-cc-section\" style=\"margin-top: 25px; font-size: 11pt;\">\r\n    <strong>Copy to:</strong>\r\n    <ol style=\"margin: 5px 0 0 20px; padding: 0;\">\r\n        {% for cc in doc.cc_list %}\r\n            <li style=\"margin-bottom: 4px;\">\r\n                {# Display Internal or External Recipient Name #}\r\n                {% if cc.recipient_type == 'Internal User' %}\r\n                    {{ cc.internal_desk_cc }}\r\n                {% else %}\r\n                    {{ cc.external_name }} {% if cc.external_email %}({{ cc.external_email }}){% endif %}\r\n                {% endif %}\r\n                \r\n                {# Display Remarks if they exist #}\r\n                {% if cc.cc_remarks %}\r\n                    <span> \u2014 {{ cc.cc_remarks }}</span>\r\n                {% endif %}\r\n            </li>\r\n        {% endfor %}\r\n    </ol>\r\n</div>\r\n{% endif %}\r\n</div>",
