 "html": "<div style=\"font-family: Arial, sans-serif; font-size: 11pt; line-height: 1.6; max-width: 800px; margin: auto;\">\n    \n    <!-- KVC3 CUSTOM LETTER HEAD -->\n    <table style=\"width: 100%; border-bottom: 2px solid #2c3e50; padding-bottom: 15px; margin-bottom: 25px;\">\n        <tr>\n            <!-- Logo Column -->\n            <td style=\"width: 15%; vertical-align: middle; text-align: left;\">\n                <img src=\"/files/kvc3_logo.png\" style=\"max-width: 110px; height: auto;\" alt=\"KVC3 Logo\">\n            </td>\n            <!-- Text Column -->\n            <td style=\"width: 85%; vertical-align: middle; text-align: center; line-height: 1.4;\">\n                <h2 style=\"margin: 0; color: #2c3e50; font-size: 18pt; font-weight: bold;\">KENDRIYA VIHAR PHASE-III</h2>\n                <h3 style=\"margin: 3px 0; color: #2c3e50; font-size: 14pt; font-weight: bold;\">ADHOC APARTMENT OWNERS ASSOCIATION (AoA)</h3>\n                <p style=\"margin: 0; font-size: 10.5pt; color: #333;\">Paruthipattu, Avadi, Chennai - 600071</p>\n                <p style=\"margin: 0; font-size: 10.5pt; color: #333;\"><strong>Email:</strong> kvc3aoa@gmail.com</p>\n                \n                <!-- Office Bearers Row -->\n                <div style=\"margin-top: 8px; font-size: 9pt; color: #444; border-top: 1px solid #ddd; padding-top: 5px;\">\n                    <strong>President:</strong> R.P Rajalingam &nbsp;|&nbsp; \n                    <strong>Vice President:</strong> Smt R.P. Chitra Devi &nbsp;|&nbsp; \n                    <strong>Secretary:</strong> A. Mathivanan<br>\n                    <strong>Treasurer:</strong> R. Nagarajan &nbsp;|&nbsp; \n                    <strong>Joint Secretary:</strong> V. Rajaram\n                </div>\n            </td>\n        </tr>\n    </table>\n    \n    <!-- HEADER: File Number and Date -->\n    <table style=\"width: 100%; border: none; margin-bottom: 30px;\">\n        <tr>\n            <td style=\"text-align: left; vertical-align: top;\">\n                <strong>No:</strong> {{ doc.name }}<br>\n                <strong>File Ref:</strong> {{ doc.primary_file }}\n            </td>\n            <td style=\"text-align: right; vertical-align: top;\">\n                <strong>Date:</strong> {{ frappe.utils.formatdate(doc.creation) }}\n            </td>\n        </tr>\n    </table>\n\n    <!-- TO ADDRESS -->\n    <div style=\"margin-bottom: 25px;\">\n        <strong>To,</strong><br>\n        {% if doc.recipient_type == 'Internal User' %}\n            {% set desk_title = frappe.db.get_value(\"Correspond Desk Profile\", doc.internal_recipient, \"desk_title\") or doc.internal_recipient %}\n            {{ desk_title }}\n        {% else %}\n            {{ doc.receiver | replace('\\n', '<br>') }}<br>\n            {{ doc.receiver_email }}\n        {% endif %}\n    </div>\n\n    <!-- SUBJECT & REFERENCE -->\n    <div style=\"margin-bottom: 30px; margin-left: 8%;\">\n        <table style=\"border: none; width: 100%;\">\n            <tr>\n                <td style=\"width: 50px; vertical-align: top;\"><strong>Sub:</strong></td>\n                <td>{{ doc.subject }}</td>\n            </tr>\n            {% if doc.reference %}\n            <tr>\n                <td style=\"vertical-align: top; padding-top: 5px;\"><strong>Ref:</strong></td>\n                <td style=\"padding-top: 5px;\">{{ doc.reference }}</td>\n            </tr>\n            {% endif %}\n        </table>\n    </div>\n\n    <!-- LETTER BODY -->\n    <div style=\"margin-bottom: 40px; text-align: justify;\">\n        Dear Sir/Madam,<br><br>\n        {{ doc.letter_body }}\n    </div>\n\n    <!-- SIGNATURE BLOCK -->\n    <table style=\"width: 100%; border: none; margin-top: 50px;\">\n        <tr>\n            <td style=\"width: 60%;\"></td>\n            <td style=\"text-align: center; width: 40%;\">\n                Yours faithfully,<br><br><br><br>\n                <strong>{{ doc.signature }}</strong><br>\n                \n                {% if doc.sender %}\n                    {% set sender_title = frappe.db.get_value(\"Correspond Desk Profile\", doc.sender, \"desk_title\") or doc.sender %}\n                    <span style=\"font-size: 10pt; color: #555;\">{{ sender_title }}</span>\n                {% endif %}\n            </td>\n        </tr>\n    </table>\n\n    <!-- CC LIST -->\n    {% if doc.cc_list and doc.cc_list|length > 0 %}\n    <div style=\"margin-top: 50px; font-size: 10pt;\">\n        <strong>Copy to:</strong><br>\n        <ul style=\"list-style-type: decimal; padding-left: 20px;\">\n        {% for cc in doc.cc_list %}\n            <li>\n                {% if cc.recipient_type == 'Internal User' %}\n                    {% set cc_desk = frappe.db.get_value(\"Correspond Desk Profile\", cc.internal_user, \"desk_title\") or cc.internal_user %}\n                    {{ cc_desk }}\n                {% else %}\n                    {{ cc.external_name }} ({{ cc.external_email }})\n                {% endif %}\n            </li>\n        {% endfor %}\n        </ul>\n    </div>\n    {% endif %}\n\n</div>",
